{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketzen",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // An earlier build had a server-side groups feature (Durable Object "GroupDO"). It was replaced by Drive-hosted
  // groups, so this migration retires that class. Keep both entries: they are the migration history.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupDO"] },
    { "tag": "v2", "deleted_classes": ["GroupDO"] }
  ]
}
